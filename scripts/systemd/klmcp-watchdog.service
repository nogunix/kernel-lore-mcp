[Unit]
Description=kernel-lore-mcp: detect silent sync/index failures
Documentation=https://github.com/nogunix/kernel-lore-mcp
After=klmcp.service

[Service]
Type=oneshot
# Never race the writer: a sync or reindex mid-flight makes generation
# and bm25 doc counts read inconsistently, and a reindex additionally
# suppresses sync for its whole run, which reads as a frozen corpus.
ExecCondition=/bin/sh -c 'for u in klmcp-sync.service klmcp-reindex.service; do case "$(/usr/bin/systemctl --user show $u -p ActiveState --value)" in active|activating|reloading|deactivating) exit 1 ;; esac; done; exit 0'
WorkingDirectory=%h
Environment=KLMCP_DATA_DIR=/mnt/hdd/klmcp-data
Environment=KLMCP_STATUS_URL=http://127.0.0.1:8099/status
ExecStart=%h/.local/bin/klmcp-watchdog
